# ──────────────────────────────────────────────
# Database
# ──────────────────────────────────────────────
# SQLite (development)
DATABASE_URL="file:./prisma/dev.db"

# PostgreSQL (production) — uncomment and replace values
# DATABASE_URL="postgresql://user:password@db:5432/umd?schema=public"

# ──────────────────────────────────────────────
# Authentication
# ──────────────────────────────────────────────
# Must be at least 32 characters
JWT_SECRET="change-me-to-a-random-secret-min-32-chars"

# ──────────────────────────────────────────────
# Server
# ──────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# Comma-separated allowed origins (leave blank to allow all in dev)
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ──────────────────────────────────────────────
# Download worker
# ──────────────────────────────────────────────
# Set to "false" to use BullMQ + Redis instead of the in-process worker
DIRECT_WORKER=true

# Path where downloaded files are stored (local storage)
DOWNLOAD_DIR="/tmp/umd-downloads"

# ──────────────────────────────────────────────
# Storage provider: local | s3 | r2 | b2
# ──────────────────────────────────────────────
STORAGE_PROVIDER=local

# S3 / R2 / B2 settings (only required when STORAGE_PROVIDER != local)
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_BUCKET=my-bucket
# S3_KEY_ID=AKIAIOSFODNN7EXAMPLE
# S3_SECRET=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
# S3_PUBLIC_URL=https://cdn.example.com

# ──────────────────────────────────────────────
# Redis (only required when DIRECT_WORKER=false)
# ──────────────────────────────────────────────
# REDIS_URL=redis://localhost:6379
