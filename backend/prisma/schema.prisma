generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  name         String
  passwordHash String
  plan         String        @default("free")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  jobs         DownloadJob[]
}

model DownloadJob {
  id        String          @id @default(uuid())
  userId    String?
  visitorId String?
  sourceUrl String
  qualityId String          @default("best")
  audioOnly Boolean         @default(false)
  status    String          @default("queued")
  progress  Int             @default(0)
  speed     String?
  eta       String?
  error     String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  user      User?           @relation(fields: [userId], references: [id])
  result    DownloadResult?
}

model DownloadResult {
  id            String      @id @default(uuid())
  jobId         String      @unique
  fileName      String
  storagePath   String
  fileSizeBytes Int?
  resolution    String?
  codec         String?
  completedAt   DateTime    @default(now())
  job           DownloadJob @relation(fields: [jobId], references: [id])
}
